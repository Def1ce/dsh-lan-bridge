{
  "name": "dsh-lan-bridge",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin + LAN bridge: injects a crypto.randomUUID polyfill so the harness web UI works over plain HTTP from phones (no certs, no public tunnels, works on old iOS). Install as a dsh plugin, or run the standalone proxy via the CLI.",
  "type": "module",
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-lan-bridge": "bin/dsh-bridge.cjs"
  },
  "files": [
    "bin",
    "dsh",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/dsh-bridge.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "plugin",
    "lan",
    "proxy",
    "reverse-proxy",
    "randomuuid",
    "polyfill",
    "mobile",
    "ipad",
    "obs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Def1ce/dsh-lan-bridge.git"
  }
}
